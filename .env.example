# Postgres Connection String (Required for SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5433/rag_db

# Redis connection string for Celery Broker/Backend
REDIS_URL=redis://localhost:6379/0

# Google Gemini API Key for Langchain embeddings and generation
GOOGLE_API_KEY=your_gemini_api_key_here
